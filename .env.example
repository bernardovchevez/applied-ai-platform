# Copy to .env (or .env.localhost / .env.stage / .env.production) and fill in keys.
# Never commit .env files with real secrets.

# Runtime environment: localhost | stage | production
APP_ENV=localhost

# State store for BFF agent_sessions and feedback:
# auto (sqlite in localhost, postgres in stage/production) | sqlite | postgres
# STATE_STORE_BACKEND=auto

# Optional API key required on /v1/* BFF routes when set (recommended in stage/production)
# BFF_API_KEY=

# --- Provider selection (auto-detect in localhost; defaults to openai in stage/production) ---
# Force local Ollama when OpenAI billing isn't ready:
# LLM_PROVIDER=ollama
# EMBEDDING_PROVIDER=ollama

# Required for cloud providers (optional in localhost if using Ollama only)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# OpenAI models (when LLM_PROVIDER=openai)
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini

# Ollama (local only: brew install ollama)
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# LangSmith tracing (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=applied-ai-platform

# Pinecone (serverless)
PINECONE_API_KEY=
PINECONE_INDEX=media-docs-index
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# pgvector (matches docker-compose.yml in localhost)
DATABASE_URL=postgresql://postgres:dev@localhost:5432/applied_ai

# FastAPI BFF comma-separated browser origins
BFF_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Langfuse observability (optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# MLflow tracking (optional, default: sqlite under platform/ops/mlflow.db)
# MLFLOW_TRACKING_URI=sqlite:///platform/ops/mlflow.db
