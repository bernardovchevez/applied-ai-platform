# Localhost environment template (.env.localhost)
APP_ENV=localhost
STATE_STORE_BACKEND=sqlite

LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

DATABASE_URL=postgresql://postgres:dev@localhost:5432/applied_ai
BFF_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
BFF_ENABLE_DOCS=true
